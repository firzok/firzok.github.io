---
import { profile } from "../../content/resume";
---

<section id="contact" class="card contact reveal">
  <h2>Get In Touch</h2>
  <p>
    I am open to senior frontend and product engineering opportunities where performance, reliability, and UX
    quality matter.
  </p>
  <div class="contact-links">
    <a href={`mailto:${profile.email}`}>{profile.email}</a>
    <a href={profile.linkedin} target="_blank" rel="noreferrer noopener">LinkedIn</a>
    <a href={profile.github} target="_blank" rel="noreferrer">GitHub</a>
  </div>
</section>
